{
    "name": "lucinda/framework",
    "type": "project",
    "description": "Lucinda Framework 4.0: High performance, component-based PHP application skeleton",
    "keywords": ["mvc","templating","errors","logging","security","oauth2","sql","nosql","caching","fast","simple","light weight","internationalization","localization","i18n"],
    "homepage": "https://www.lucinda-framework.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Lucian Popescu",
            "email": "lucian.gabriel.popescu@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "ext-simplexml": "*",    
        "lucinda/framework-engine": "~4.0",
        "lucinda/logging": "~5.0",
        "lucinda/nosql-data-access": "~5.0",
        "lucinda/oauth2-client": "~4.0",
        "lucinda/security": "~5.0",
        "lucinda/mvc": "~5.0",
        "lucinda/sql-data-access": "~5.0",
        "lucinda/view-language": "~5.0",
        "lucinda/internationalization": "~5.0",
        "lucinda/errors-mvc": "~4.0",
        "lucinda/headers": "~3.0",
        "lucinda/abstract_mvc": "~3.0",
        "lucinda/console-mvc": "~3.0",
        "lucinda/migrations": "^3.0",
        "lucinda/console-view": "~1.0"
    },
    "require-dev": {
        "lucinda/unit-testing": "^2.0"
    },
    "autoload": {
    	"psr-4": {
          "Lucinda\\Project\\": "src/",
          "Test\\Lucinda\\Project\\": "tests/"
    	}
    },
    "scripts": {
        "post-create-project-cmd": [
            "php configure.php create-folders"
        ]
    }
}
